'] = flight_data['kinetic_energy_joules'] / 4.184e9\n","print(\"\\nEquivalent in Tons of TNT:\")\n","print(flight_data[['date', 'kinetic_energy_TNT_equivalent']])"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":14,"status":"ok","timestamp":1778397347667,"user":{"displayName":"ThinkStopSilence Dean (Bordode)","userId":"06715189387177098329"},"user_tz":420},"id":"aMmwrwTdlwGU","outputId":"131cb4f5-65fd-4052-9cee-6d431d49d098"},"outputs":[{"name":"stdout","output_type":"stream","text":["Estimated Power Requirements (Gigawatts):\n","         date  velocity_mach  power_gigawatts\n","0  2004-11-14            5.2         1.590614\n","1  2015-01-21            3.8         0.849426\n","2  2019-07-15            4.5         1.191196\n"]}],"source":["# Estimate power requirements (assuming 1-second acceleration)\n","flight_data['power_gigawatts'] = flight_data['kinetic_energy_joules'] / 1e9  # 1 GW = 1e9 W\n","print(\"Estimated Power Requirements (Gigawatts):\")\n","print(flight_data[['date', 'velocity_mach', 'power_gigawatts']])"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":36,"status":"ok","timestamp":1778398410176,"user":{"displayName":"ThinkStopSilence Dean (Bordode)","userId":"06715189387177098329"},"user_tz":420},"id":"90HwRhgvwjvP","outputId":"71fddbaf-8a55-4ec8-bc6c-581ad8063a8e"},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing uap_dashboard.py\n"]}],"source":["%%writefile uap_dashboard.py\n","import streamlit as st\n","import pandas as pd\n","import plotly.express as px\n","\n","st.title(\"UAP Propulsion Analysis Dashboard\")\n","st.write(\"Explore UAP power, energy, and propulsion feasibility.\")\n","\n","try:\n","    flight_data = pd.read_csv('uap_flight_data.csv')\n","    flight_data['velocity_ms'] = flight_data['velocity_mach'] * 343\n","    flight_data['kinetic_energy_joules'] =